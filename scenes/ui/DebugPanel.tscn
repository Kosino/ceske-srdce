[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/DebugPanel.gd" id="1_debug"]

[node name="DebugPanel" type="CanvasLayer"]
script = ExtResource("1_debug")

[node name="Panel" type="PanelContainer" parent="."]
offset_left = 12.0
offset_top = 12.0
offset_right = 340.0
offset_bottom = 400.0

[node name="Margin" type="MarginContainer" parent="Panel"]
layout_mode = 2
theme_override_constants/margin_left = 8
theme_override_constants/margin_top = 6
theme_override_constants/margin_right = 8
theme_override_constants/margin_bottom = 6

[node name="VBox" type="VBoxContainer" parent="Panel/Margin"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="StatsLabel" type="Label" parent="Panel/Margin/VBox"]
layout_mode = 2
text = "Food: 0
Wood: 0
Gold: 0
Stone: 0
Pop: 0 / 0
Age: 1"

[node name="FpsLabel" type="Label" parent="Panel/Margin/VBox"]
layout_mode = 2
text = "FPS: 0"

[node name="BuildLabel" type="Label" parent="Panel/Margin/VBox"]
layout_mode = 2
text = "Kasarna: ..."

[node name="TestButtons" type="HBoxContainer" parent="Panel/Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="AddFood" type="Button" parent="Panel/Margin/VBox/TestButtons"]
layout_mode = 2
text = "+50 Food"

[node name="AddWood" type="Button" parent="Panel/Margin/VBox/TestButtons"]
layout_mode = 2
text = "+50 Wood"

[node name="AdvanceAge" type="Button" parent="Panel/Margin/VBox/TestButtons"]
layout_mode = 2
text = "Age+"

[node name="BuildButtons" type="HBoxContainer" parent="Panel/Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="PlaceHouse" type="Button" parent="Panel/Margin/VBox/BuildButtons"]
layout_mode = 2
text = "Dum"

[node name="PlaceBarracks" type="Button" parent="Panel/Margin/VBox/BuildButtons"]
layout_mode = 2
text = "Kasarna"

[node name="PlaceLumber" type="Button" parent="Panel/Margin/VBox/BuildButtons"]
layout_mode = 2
text = "Pila"

[node name="PlaceMill" type="Button" parent="Panel/Margin/VBox/BuildButtons"]
layout_mode = 2
text = "Mlyn"

[node name="PlaceArchery" type="Button" parent="Panel/Margin/VBox/BuildButtons"]
layout_mode = 2
text = "Strelnice"

[node name="TrainButtons" type="HBoxContainer" parent="Panel/Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="TrainSoldier" type="Button" parent="Panel/Margin/VBox/TrainButtons"]
layout_mode = 2
text = "Zbroj"

[node name="TrainSpearman" type="Button" parent="Panel/Margin/VBox/TrainButtons"]
layout_mode = 2
text = "Kop"

[node name="TrainArcher" type="Button" parent="Panel/Margin/VBox/TrainButtons"]
layout_mode = 2
text = "Luc"

[node name="TrainVillager" type="Button" parent="Panel/Margin/VBox/TrainButtons"]
layout_mode = 2
text = "Vesn"

[connection signal="pressed" from="Panel/Margin/VBox/TestButtons/AddFood" to="." method="_on_add_food_pressed"]
[connection signal="pressed" from="Panel/Margin/VBox/TestButtons/AddWood" to="." method="_on_add_wood_pressed"]
[connection signal="pressed" from="Panel/Margin/VBox/TestButtons/AdvanceAge" to="." method="_on_advance_age_pressed"]
[connection signal="pressed" from="Panel/Margin/VBox/BuildButtons/PlaceHouse" to="." method="_on_place_house_pressed"]
[connection signal="pressed" from="Panel/Margin/VBox/BuildButtons/PlaceBarracks" to="." method="_on_place_barracks_pressed"]
[connection signal="pressed" from="Panel/Margin/VBox/BuildButtons/PlaceLumber" to="." method="_on_place_lumber_pressed"]
[connection signal="pressed" from="Panel/Margin/VBox/BuildButtons/PlaceMill" to="." method="_on_place_mill_pressed"]
[connection signal="pressed" from="Panel/Margin/VBox/BuildButtons/PlaceArchery" to="." method="_on_place_archery_pressed"]
[connection signal="pressed" from="Panel/Margin/VBox/TrainButtons/TrainSoldier" to="." method="_on_train_soldier_pressed"]
[connection signal="pressed" from="Panel/Margin/VBox/TrainButtons/TrainSpearman" to="." method="_on_train_spearman_pressed"]
[connection signal="pressed" from="Panel/Margin/VBox/TrainButtons/TrainArcher" to="." method="_on_train_archer_pressed"]
[connection signal="pressed" from="Panel/Margin/VBox/TrainButtons/TrainVillager" to="." method="_on_train_villager_pressed"]