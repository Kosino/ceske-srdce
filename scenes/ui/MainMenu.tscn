[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/MainMenu.gd" id="1_menu"]

[node name="MainMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_menu")

[node name="Bg" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.12, 0.16, 0.12, 1)

[node name="Center" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -200.0
offset_top = -180.0
offset_right = 200.0
offset_bottom = 180.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 14

[node name="TitleLabel" type="Label" parent="Center"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 36
text = "České srdce"
horizontal_alignment = 1

[node name="Subtitle" type="Label" parent="Center"]
layout_mode = 2
text = "Vyber civilizace"
horizontal_alignment = 1

[node name="PlayerRow" type="HBoxContainer" parent="Center"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="PlayerLbl" type="Label" parent="Center/PlayerRow"]
layout_mode = 2
size_flags_horizontal = 3
text = "Hráč"

[node name="PlayerCivOption" type="OptionButton" parent="Center/PlayerRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3

[node name="EnemyRow" type="HBoxContainer" parent="Center"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="EnemyLbl" type="Label" parent="Center/EnemyRow"]
layout_mode = 2
size_flags_horizontal = 3
text = "AI"

[node name="EnemyCivOption" type="OptionButton" parent="Center/EnemyRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3

[node name="PlayButton" type="Button" parent="Center"]
layout_mode = 2
text = "Hrát"

[node name="QuitButton" type="Button" parent="Center"]
layout_mode = 2
text = "Konec"

[connection signal="pressed" from="Center/PlayButton" to="." method="_on_play_pressed"]
[connection signal="pressed" from="Center/QuitButton" to="." method="_on_quit_pressed"]
